# Genesis Plus GX - GUI C++ Test Makefile
# Quick compilation test for GUI classes

CXX := powerpc-eabi-g++
CXXFLAGS := -O2 -Wall -Wextra -fno-exceptions -fno-rtti -std=c++11
CXXFLAGS += -I$(DEVKITPRO)/libogc/include

SOURCES := gui_element.cpp gui_trigger.cpp gui_sound.cpp
OBJECTS := $(SOURCES:.cpp=.o)

.PHONY: all clean test

all: test

test: $(OBJECTS)
	@echo "GUI classes compiled successfully!"
	@echo "Objects: $(OBJECTS)"

%.o: %.cpp gui.h
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS)

# Check if devkitPPC is available
check-env:
	@if [ -z "$(DEVKITPRO)" ]; then \
		echo "Error: DEVKITPRO not set"; \
		exit 1; \
	fi
	@echo "Using devkitPro: $(DEVKITPRO)"
